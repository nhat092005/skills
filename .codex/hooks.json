{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "create_goal|set_goal|set_goals|goal",
        "hooks": [
          {
            "type": "command",
            "command": "node /home/nhat/.codex/hooks/goal_guard.mjs",
            "statusMessage": "Goal Guard: LLM goal review"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node /home/nhat/.codex/hooks/post_bash_git_commit_gitnexus.mjs",
            "statusMessage": "Run gitnexus analyze after git commit"
          }
        ]
      }
    ]
  }
}
